# Environment Variables para Producción

# Node Environment
NODE_ENV=production

# Puerto de la aplicación (Docker usa 3000 por defecto)
PORT=3000

# Hostname para Next.js
HOSTNAME=0.0.0.0

# Next.js Telemetry (opcional)
# NEXT_TELEMETRY_DISABLED=1

# Agrega aquí tus variables de entorno específicas de la aplicación
# Ejemplos:
# DATABASE_URL=postgresql://user:password@host:5432/database
# API_KEY=your-api-key
# JWT_SECRET=your-secret-key
